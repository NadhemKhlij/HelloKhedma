{
  "name": "hellokhedma",
  "private": true,
  "description": "HelloKhedma: job hunting companion for tech careers (offers, courses, CV + ATS score, interview prep, tracker). Static PWA + Supabase.",
  "scripts": {
    "build": "node scripts/write-config.mjs && tailwindcss -i css/input.css -o css/app.css --minify",
    "build:css": "tailwindcss -i css/input.css -o css/app.css --minify",
    "watch:css": "tailwindcss -i css/input.css -o css/app.css --watch",
    "check-links": "node scripts/check-links.mjs",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "tailwindcss": "3.4.17"
  }
}
